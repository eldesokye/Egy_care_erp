<?xml version="1.0" encoding="utf-8"?>
<!-- Egy Care Tickets - Configuration: Ticket Sources & Ticket Types -->
<odoo>
    <!-- ============================== SOURCES ============================== -->
    <record id="view_egy_care_ticket_source_list" model="ir.ui.view">
        <field name="name">egy.care.ticket.source.list</field>
        <field name="model">egy.care.ticket.source</field>
        <field name="arch" type="xml">
            <list string="Ticket Sources" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_egy_care_ticket_source_form" model="ir.ui.view">
        <field name="name">egy.care.ticket.source.form</field>
        <field name="model">egy.care.ticket.source</field>
        <field name="arch" type="xml">
            <form string="Ticket Source">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Internal description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_egy_care_ticket_source" model="ir.actions.act_window">
        <field name="name">Ticket Sources</field>
        <field name="res_model">egy.care.ticket.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =============================== TYPES =============================== -->
    <record id="view_egy_care_ticket_type_list" model="ir.ui.view">
        <field name="name">egy.care.ticket.type.list</field>
        <field name="model">egy.care.ticket.type</field>
        <field name="arch" type="xml">
            <list string="Ticket Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="category" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_egy_care_ticket_type_form" model="ir.ui.view">
        <field name="name">egy.care.ticket.type.form</field>
        <field name="model">egy.care.ticket.type</field>
        <field name="arch" type="xml">
            <form string="Ticket Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Internal description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_egy_care_ticket_type" model="ir.actions.act_window">
        <field name="name">Ticket Types</field>
        <field name="res_model">egy.care.ticket.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
